<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net6.0</TargetFramework>
	<RootNamespace>BroadcastAPI</RootNamespace>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
    <Version>1.1.0</Version>
	<GameModsPath>C:/Program Files (x86)/Steam/steamapps/common/Stardew Valley/Mods (dev)</GameModsPath>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Lib.Harmony" Version="2.4.2" />
	<PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

   <Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="powershell -Command &quot;Expand-Archive -Path '$(OutputPath)BroadcastAPI $(Version).zip' -DestinationPath '$(GameModsPath)' -Force&quot;" />
	</Target>

</Project>
